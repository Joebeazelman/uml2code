with "uml_model";
with "plantuml_parser";
with "jintp";
with "string_utilities";

project UML2Code is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Main use ("uml2code_main.adb");
   for Exec_Dir use "bin";

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnatX", "-gnatwa");
   end Compiler;
end UML2Code;
