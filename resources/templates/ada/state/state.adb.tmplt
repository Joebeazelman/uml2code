package body {{ PACKAGE_NAME }} is
{% for action_hook in action_hooks %}
   procedure {{ action_hook.name }} is null;
{% endfor %}

   function Current_State (Self : Machine) return State is
   begin
      return Self.Current;
   end Current_State;

   procedure Reset (Self : in out Machine) is
   begin
      Self.Current := {{ INITIAL_STATE | ident }};
{% for composite in composite_states %}      {{ composite.child_package }}.Reset (Self.{{ composite.child_field }});
{%- endfor %}
   end Reset;

   type Transition_Result is record
      Has_Transition : Boolean;
      Target         : State;
      Is_Terminal    : Boolean;
   end record;

   type Transition_Table is array (State, Event) of Transition_Result;

   Table : constant Transition_Table :=
       [{% for state in states %}{{ state.table_separator }}{{ state.id | ident }} => [{{ state.table_row }}]{% endfor %}];

   procedure Step (Self : in out Machine; Evt : Event) is
      Current_Transition : constant Transition_Result :=
        Table (Self.Current, Evt);
   begin
      --  Exit actions
      case Self.Current is
   {% for state in states %}{% if state.has_exit_actions %}         when {{ state.id | ident }} =>
   {% for action in state.exit_actions %}
            {{ action }};
   {% endfor %}{% endif %}{% endfor %}{% if has_exit_action_others %}         when others => null;
   {% endif %}
      end case;

      --  Internal transitions (checked before state change)
      case Self.Current is
   {% for state in states %}{% if state.has_internal_transitions %}         when {{ state.id | ident }} =>
   {% for ann in state.annotations %}{% if ann.kind == "Internal_Transition" %}
            if Evt = {{ ann.trigger | ident }} then
               {{ ann.action }};
               return;
            end if;
   {% endif %}{% endfor %}{% endif %}{% endfor %}{% if has_internal_transition_others %}         when others => null;
   {% endif %}
      end case;

   --  Do activities run while their state remains active.
   case Self.Current is
   {% for state in states %}{% if state.has_do_actions %}         when {{ state.id | ident }} =>
   {% for action in state.do_actions %}
      {{ action }};
   {% endfor %}{% endif %}{% endfor %}{% if has_do_action_others %}         when others => null;
   {% endif %}
   end case;

      --  State transition
   if Current_Transition.Has_Transition then
         --  Check if transitioning to terminal state
      if Current_Transition.Is_Terminal then
            State_Machine.Mark_Terminated (Self);
            return;
         end if;

{% if has_multiple_states %}
{% for composite in composite_states %}         --  Reset child machine on entry to composite state
         declare
            function Is_Entering
              (Current, Target, Candidate : State) return Boolean
            is
            begin
               return Target = Candidate and then Current /= Candidate;
            end Is_Entering;
         begin
            if Is_Entering
              (Self.Current,
               Current_Transition.Target,
               {{ composite.name | ident }})
            then
            declare
               Via_History : constant Boolean := False;  --  TODO: implement history
            begin
               if not Via_History then
                  {{ composite.child_package }}.Reset (Self.{{ composite.child_field }});
               end if;
            end;
         end if;
         end;
{% endfor %}
{% endif %}
         Self.Current := Current_Transition.Target;

         --  Entry actions
         case Self.Current is
{% for state in states %}{% if state.has_entry_actions %}            when {{ state.id | ident }} =>
{% for action in state.entry_actions %}
               {{ action }};
{% endfor %}{% endif %}{% endfor %}{% if has_entry_action_others %}            when others => null;
{% endif %}
         end case;
      end if;
   end Step;
{% for composite in composite_states %}

   function {{ composite.name | ident }}_State (Self : Machine) return {{ composite.child_package }}.State is
   begin
      return {{ composite.child_package }}.Current_State (Self.{{ composite.child_field }});
   end {{ composite.name | ident }}_State;

   procedure Step_{{ composite.name | ident }} (Self : in out Machine; Evt : {{ composite.child_package }}.Event) is
   begin
      {{ composite.child_package }}.Step (Self.{{ composite.child_field }}, Evt);
   end Step_{{ composite.name | ident }};
{% endfor %}

end {{ PACKAGE_NAME }};
